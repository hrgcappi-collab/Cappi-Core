# Дописать в infra/prod/Caddyfile проекта CappiX.
# Caddy сам получит сертификат, отдельно ничего делать не надо.

core.cappi.ua {
	# Наружу открыт только приём событий — остальное боту не нужно,
	# он сам ходит в Telegram, а не принимает оттуда.
	handle /webhook/* {
		reverse_proxy cappi-core:8787
	}
	handle /health {
		reverse_proxy cappi-core:8787
	}
	handle {
		respond "Cappi Core" 200
	}
}
