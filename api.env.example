# Скопировать в ~/.cappi/api.env и заполнить. chmod 600.

# --- Syrve ТП «Cappi Одесса» — здесь живут приказы о ценах ---
SYRVE_TP_URL=https://cappi.syrve.online
SYRVE_TP_LOGIN=
SYRVE_TP_PASSWORD=

# --- Syrve HQ (chain) — номенклатура, склады, отчёты ---
SYRVE_SERVER_URL=https://cappi-co.syrve.online
SYRVE_API_LOGIN=
SYRVE_API_PASSWORD=

# --- Syrve Cloud API (EU) — реальные цены, стоп-листы ---
SYRVE_CLOUD_URL=https://api-eu.syrve.live
SYRVE_CLOUD_API_KEY=
SYRVE_ORG_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Только для первого запуска: эти id станут админами, дальше доступ
# раздаётся из самого бота и хранится в ~/.cappi/access.json
TELEGRAM_ALLOWED_IDS=

# --- Cappi Admin ---
CAPPI_ADMIN_URL=https://api.cappi.ua
CAPPI_ADMIN_TOKEN=
